# All optional. Without PLAID_CLIENT_ID/PLAID_SECRET the CLI reads them from the macOS Keychain
# (service "personal-budget-plaid-excel", accounts plaid-client-id / plaid-secret / plaid-environment).
PLAID_CLIENT_ID=your-plaid-client-id
PLAID_SECRET=your-plaid-secret
PLAID_ENV=sandbox
PLAID_CLIENT_NAME=Personal Budget Excel
PLAID_COUNTRY_CODES=US
PLAID_CLIENT_USER_ID=personal-budget-owner
PLAID_REDIRECT_URI=
PLAID_WEBHOOK_URL=
# Authority workbook path (default ./budget.xlsx)
BUDGET_WORKBOOK=budget.xlsx
